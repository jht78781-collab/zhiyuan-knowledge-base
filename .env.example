# Copy to .env at the project root. Use unquoted values. Environment variables take precedence.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
DB_URL=jdbc:mariadb://127.0.0.1:3307/enterprise_kb
DB_USER=enterprise_kb
DB_PASSWORD=
APP_SECURE_COOKIE=false

# Set a strong one-time bootstrap password (12+ characters). Leave blank after first startup.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=enterprise-kb

# Dify Service API base URL (includes /v1). Keys stay in this server-side configuration.
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_KNOWLEDGE_KEY=
# JSON alias -> app API key. Use a separate Chatflow and key for each knowledge base.
DIFY_CHAT_KEYS={}
APP_UPLOAD_LIMIT=15MB
APP_JOB_DELAY_MS=3500
APP_DIFY_CONNECT_TIMEOUT_MS=5000
APP_DIFY_READ_TIMEOUT_MS=90000
APP_STATS_TIME_ZONE=Asia/Shanghai
